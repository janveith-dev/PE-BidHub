# Kopie als .env ablegen. Ohne Schlüssel startet die Plattform; die jeweilige Funktion meldet dann, was fehlt.

# Claude (Analyse, Recherche, Schreiben, Prüfen, Chat) – https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelle je Rolle (Standard in Klammern)
# MODEL_CHAT=claude-sonnet-5-5   MODEL_RESEARCH=claude-sonnet-5-5   MODEL_EDITOR=claude-sonnet-5-5
# MODEL_ANALYST=claude-opus-5-5  MODEL_WRITER=claude-opus-5-5       MODEL_REVIEWER=claude-opus-5-5
# Serverseitiger Fallback der Claude-API bei Sicherheitsablehnungen (0 schaltet ihn ab)
# LLM_REFUSAL_FALLBACK=1

# Sprachausgabe – https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Websuche: Domains, die nie geliefert werden dürfen (kommagetrennt), z. B. Wettbewerber
WEB_BLOCKED_DOMAINS=

# Absender auf dem Deckblatt
COMPANY_NAME=public edge GmbH

# Betrieb
POSTGRES_PASSWORD=bitte_aendern
WEB_PORT=8080
WHISPER_MODEL=small
