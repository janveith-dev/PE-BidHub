    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.2",
    "docx": "^9.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.0",
    "marked": "^15.0.7",
    "pg": "^8.13.3",
    "tsx": "^4.19.2",
    "unpdf": "^1.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.11",
    "esbuild": "^0.25.0",
    "fast-xml-parser": "^5.11.2",
    "pino-pretty": "^13.1.3"
